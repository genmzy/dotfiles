# ---
# --- Window and Appearance ---
# ---

background-opacity = 1.0
# background-blur-radius = 30
custom-shader = ~/.config/ghostty/cursor_smear.glsl
background-image = ~/.config/wallpapers/catppuccin-girls.png
background-image-opacity = 0.1
background-image-fit = cover
# macos-titlebar-style = transparent
window-padding-x = 0
window-padding-y = 0
window-save-state = always
window-theme = ghostty
window-decoration = none
gtk-toolbar-style = raised
gtk-wide-tabs = false
# comment this will hidden tab tar
window-show-tab-bar = never
gtk-tabs-location = hidden
adjust-underline-thickness = -80%
adjust-strikethrough-thickness = -80%
adjust-overline-thickness = -80%
# adjust-overline-thickness = +15%

# cursor
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 0.8
# link previews under cursor
link-previews = false
